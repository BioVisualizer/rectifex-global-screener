{
    "app-id": "com.rectifex.GlobalScreener",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.7",
    "sdk": "org.kde.Sdk",
    "command": "run-app.sh",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-cache"
    ],
    "modules": [
        {
            "name": "rectifex-global-screener",
            "buildsystem": "simple",
            "build-options": {
                "no-seccomp": true
            },
            "build-commands": [
                "pip3 install --prefix=/app --no-index --find-links=packaging/flatpak/vendor -r requirements.txt",
                "mkdir -p /app/src",
                "cp -r app core cli /app/src/",
                "install -Dm755 packaging/flatpak/run-app.sh /app/bin/run-app.sh",
                "install -Dm755 packaging/flatpak/run-cli.sh /app/bin/rectifex-cli",
                "install -Dm644 packaging/flatpak/com.rectifex.GlobalScreener.desktop /app/share/applications/com.rectifex.GlobalScreener.desktop",
                "install -Dm644 packaging/flatpak/assets/com.rectifex.GlobalScreener.png /app/share/icons/hicolor/128x128/apps/com.rectifex.GlobalScreener.png",
                "install -Dm644 packaging/flatpak/assets/com.rectifex.GlobalScreener-256.png /app/share/icons/hicolor/256x256/apps/com.rectifex.GlobalScreener.png",
                "install -Dm644 packaging/flatpak/com.rectifex.GlobalScreener.metainfo.xml /app/share/metainfo/com.rectifex.GlobalScreener.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        "venv-flatpak",
                        ".git",
                        ".flatpak-builder"
                    ]
                }
            ]
        }
    ]
}