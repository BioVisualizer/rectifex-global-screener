{
  "app-id": "com.rectifex.GlobalScreener",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.7",
  "sdk": "org.kde.Sdk",
  "command": "run-app",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "python-deps",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "PIP_DISABLE_PIP_VERSION_CHECK": "1",
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "build-commands": [
        "pip3 install --no-cache-dir --prefix=/app -r vendor/requirements.txt"
      ],
      "sources": [
        {
          "type": "file",
          "path": "vendor/requirements.txt",
          "dest": "vendor",
          "dest-filename": "requirements.txt"
        }
      ]
    },
    {
      "name": "app",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 /usr/bin/python3 /app/bin/python3",
        "install -Dm755 packaging/flatpak/run-app /app/bin/run-app",
        "install -Dm755 packaging/flatpak/run-app-debug /app/bin/run-app-debug",
        "cp -r app /app/app",
        "cp -r core /app/core"
      ],
      "sources": [
        { "type": "dir", "path": "." }
      ]
    }
  ]
}
